PORT=3001
# Used only as the source directory for the one-time Supabase migration.
DATA_DIR=./data
# Server-only Supabase credentials. Never expose the secret key in browser code.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Automatic contact-form email. Fill in the sending account's credentials.
INQUIRY_EMAIL_TO=brandon.geraldo28@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
# For Gmail, use an App Password, not the account's regular password.
SMTP_PASS=
# The sending email address authorized by your SMTP provider.
MAIL_FROM=
