{
  "name": "sumber-hidup",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --watch server/index.mjs\" \"vite --host 0.0.0.0\"",
    "build": "tsc -b && vite build",
    "start": "node server/index.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "npm run test:email && npm run test:store && npm run test:vercel && npm run build && playwright test",
    "test:email": "node --test server/email.test.mjs",
    "test:store": "node --test server/store.test.mjs",
    "test:vercel": "node --test server/vercel.test.mjs",
    "email:check": "node scripts/check-email.mjs",
    "db:migrate": "node scripts/migrate-to-supabase.mjs",
    "typecheck": "tsc -b",
    "format": "prettier --write src server scripts tests docs *.json *.ts README.md index.html"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.2.0",
    "@fontsource/inter": "^5.2.0",
    "@supabase/supabase-js": "^2.109.0",
    "compression": "^1.8.2",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "nodemailer": "^10.0.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0",
    "ws": "^8.21.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "prettier": "^3.9.8",
    "sharp": "^0.34.5",
    "typescript": "~5.9.3",
    "vite": "^6.4.3"
  }
}
